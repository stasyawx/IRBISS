<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Profile"
    android:background="@color/back2">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:textColor="@color/blackk"
                android:textSize="25dp"
                android:textStyle="bold"
                android:layout_marginTop="50dp"
                android:text="Профиль"/>

            <LinearLayout
                android:id="@+id/top"
                android:layout_below="@id/history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="35dp"
                android:background="@drawable/profile_corners">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="35dp"
                    android:layout_marginVertical="20dp">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/profileCard"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_centerVertical="true"
                        app:cardCornerRadius="50dp">

                        <ImageView
                            android:id="@+id/profile"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/profile"/>
                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:id="@+id/userNameTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@id/profileCard"
                        android:layout_centerVertical="true"
                        android:textColor="@color/blackk"
                        android:textSize="18dp"
                        android:textStyle="bold"
                        android:layout_marginLeft="15dp"
                        android:text="Имя"/>

                    <ImageView
                        android:id="@+id/editprofile"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/polygon"
                        android:layout_centerVertical="true"
                        android:layout_alignParentRight="true"
                        android:rotation="90"
                        android:layout_marginRight="10dp"/>
                </RelativeLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/center"
                android:layout_below="@id/top"
                android:layout_marginTop="35dp"
                android:background="@drawable/profile_corners"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="20dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="35dp"
                        android:textSize="15dp"
                        android:textColor="@color/gray"
                        android:layout_gravity="left"
                        android:text="Дополнительно"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginRight="35dp"
                        android:layout_marginLeft="35dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/img1"/>
                        <TextView
                            android:id="@+id/helpTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="15dp"
                            android:textColor="@color/blackk"
                            android:layout_marginLeft="15dp"
                            android:text="Помощь и поддержка"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/profile_corners_2">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginRight="35dp"
                        android:layout_marginLeft="35dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/img2"/>
                        <TextView
                            android:id="@+id/contactTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="15dp"
                            android:textColor="@color/blackk"
                            android:layout_marginLeft="15dp"
                            android:text="Связаться с нами"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginRight="35dp"
                        android:layout_marginLeft="35dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="15dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/img3"/>
                        <TextView
                            android:id="@+id/privacyTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="15dp"
                            android:textColor="@color/blackk"
                            android:layout_marginLeft="15dp"
                            android:text="Политика конфиденциальности"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/exit"
                android:layout_below="@id/center"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:orientation="vertical"
                android:layout_marginTop="75dp"
                android:gravity="center"
                android:background="@drawable/profile_corners">

                <TextView
                    android:id="@+id/exitTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/red"
                    android:layout_gravity="center"
                    android:textSize="15dp"
                    android:textStyle="bold"
                    android:text="Выйти из профиля"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/delete"
                android:layout_below="@id/exit"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:orientation="vertical"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:background="@drawable/profile_corners">

                <TextView
                    android:id="@+id/deletePrompt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/red"
                    android:layout_gravity="center"
                    android:textSize="15dp"
                    android:textStyle="bold"
                    android:textAlignment="center"
                    android:text="Выйти из профиля и удалить\n учетную запись"/>
            </LinearLayout>
        </RelativeLayout>
    </ScrollView>
    <LinearLayout
        android:id="@+id/bottomToolbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/tool_bar"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:padding="25dp"
        android:layout_marginBottom="45dp"
        android:elevation="4dp"
        android:translationZ="2dp">

        <ImageView
            android:id="@+id/homeImageView"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/home"
            android:layout_marginLeft="35dp"
            android:layout_gravity="center"/>
        <Space
            android:layout_width="60dp"
            android:layout_height="0dp"/>
        <ImageView
            android:id="@+id/historyImageView"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/history"
            android:layout_gravity="center"/>
        <Space
            android:layout_width="60dp"
            android:layout_height="0dp"/>
        <ImageView
            android:id="@+id/profileImageView"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/profil"
            android:layout_marginRight="35dp"
            android:layout_gravity="center"/>
    </LinearLayout>
</RelativeLayout>