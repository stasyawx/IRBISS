<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".RefuelingCompleted"
    android:background="@color/back2">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="35dp"
            android:layout_marginRight="35dp">

            <ImageView
                android:id="@+id/exit"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:src="@drawable/successmark"
                android:layout_alignParentTop="true"
                android:layout_marginTop="50dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/exit"
                android:layout_marginTop="35dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="15dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Заправка выполнена!"
                        android:layout_gravity="center"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/blackk"
                        android:layout_marginBottom="15dp"/>
                </LinearLayout>

                <Button
                    android:id="@+id/exitButton"
                    android:layout_width="190dp"
                    android:layout_height="55dp"
                    android:layout_gravity="center"
                    android:text="Вернуться на главную"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:background="@drawable/button_black"
                    android:layout_marginTop="30dp"/>

            </LinearLayout>
        </RelativeLayout>
    </ScrollView>
    <LinearLayout
        android:id="@+id/bottomToolbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/tool_bar"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:padding="25dp"
        android:layout_marginBottom="45dp"
        android:elevation="4dp"
        android:translationZ="2dp">

        <ImageView
            android:id="@+id/homeImageView"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/home"
            android:layout_marginLeft="35dp"
            android:layout_gravity="center"/>
        <Space
            android:layout_width="60dp"
            android:layout_height="0dp"/>
        <ImageView
            android:id="@+id/historyImageView"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/history"
            android:layout_gravity="center"/>
        <Space
            android:layout_width="60dp"
            android:layout_height="0dp"/>
        <ImageView
            android:id="@+id/profileImageView"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/profil"
            android:layout_marginRight="35dp"
            android:layout_gravity="center"/>
    </LinearLayout>
</RelativeLayout>