<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HelpSupport"
    android:background="@color/back2">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="35dp"
            android:layout_marginRight="35dp">

            <ImageView
                android:id="@+id/exit"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/exit"
                android:layout_alignParentTop="true"
                android:layout_marginTop="50dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/exit"
                android:layout_marginTop="35dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Частые вопросы"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/blackk"
                    android:layout_marginBottom="15dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. Как активировать бонусные баллы?"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/blackk"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Баллы автоматически применяются при оплате через мобильное приложение. 1 балл = 1 рубль скидки."
                    android:textSize="15sp"
                    android:textColor="@color/dark_gray"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2. Почему не приходит письмо для сброса пароля?"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/blackk"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Проверьте спам или подождите 2-3 минуты. Если проблема сохраняется, попробуйте выполнить запрос повторно."
                    android:textSize="15sp"
                    android:textColor="@color/dark_gray"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3. ..."
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/blackk"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="..."
                    android:textSize="15sp"
                    android:textColor="@color/dark_gray"
                    android:layout_marginBottom="20dp"/>

                <Button
                    android:layout_width="250dp"
                    android:layout_height="55dp"
                    android:layout_gravity="center"
                    android:text="Написать в поддержку"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:background="@drawable/button_black"
                    android:textColor="@color/white"
                    android:layout_marginTop="15dp"/>
            </LinearLayout>
        </RelativeLayout>
    </ScrollView>
    <LinearLayout
        android:id="@+id/bottomToolbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/tool_bar"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:padding="25dp"
        android:layout_marginBottom="45dp"
        android:elevation="4dp"
        android:translationZ="2dp">

        <ImageView
            android:id="@+id/homeImageView"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/home"
            android:layout_marginLeft="35dp"
            android:layout_gravity="center"/>
        <Space
            android:layout_width="60dp"
            android:layout_height="0dp"/>
        <ImageView
            android:id="@+id/historyImageView"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/history"
            android:layout_gravity="center"/>
        <Space
            android:layout_width="60dp"
            android:layout_height="0dp"/>
        <ImageView
            android:id="@+id/profileImageView"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/profil"
            android:layout_marginRight="35dp"
            android:layout_gravity="center"/>
    </LinearLayout>
</RelativeLayout>