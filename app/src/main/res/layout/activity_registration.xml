<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Registration"
    android:background="@color/white">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="35dp"
            android:layout_marginRight="35dp">

            <ImageView
                android:id="@+id/exitButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/exit"
                android:layout_alignParentTop="true"
                android:layout_marginTop="50dp"/>

            <LinearLayout
                android:id="@+id/inputFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/exitButton"
                android:layout_marginTop="35dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Привет! Зарегистрируйтесь, чтобы начать работу"
                    android:textColor="@color/blackk"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <EditText
                    android:id="@+id/nameEditText"
                    android:background="@drawable/rounded_edittext"
                    android:textColorHint="@color/gray"
                    android:textSize="15dp"
                    android:paddingLeft="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:hint="Имя пользователя"
                    android:inputType="textCapWords|textPersonName"
                    android:textColor="@color/blackk"
                    android:layout_marginTop="45dp"/>
                <EditText
                    android:id="@+id/loginEditText"
                    android:background="@drawable/rounded_edittext"
                    android:textColorHint="@color/gray"
                    android:textSize="15dp"
                    android:paddingLeft="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:hint="Адрес электронной почты"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/blackk"
                    android:layout_marginTop="15dp"/>
                <EditText
                    android:id="@+id/passwordEditText"
                    android:background="@drawable/rounded_edittext"
                    android:textColorHint="@color/gray"
                    android:textSize="15dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:hint="Пароль"
                    android:inputType="textPassword"
                    android:textColor="@color/blackk"
                    android:layout_marginTop="15dp"/>
                <EditText
                    android:id="@+id/confirmPasswordEditText"
                    android:background="@drawable/rounded_edittext"
                    android:textColorHint="@color/gray"
                    android:textSize="15dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:hint="Подтверждение пароля"
                    android:inputType="textPassword"
                    android:textColor="@color/blackk"
                    android:layout_marginTop="15dp"/>
                <Button
                    android:id="@+id/registerButton"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:text="Зарегистрироваться"
                    android:textAllCaps="false"
                    android:textSize="15dp"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:layout_marginTop="35dp"
                    android:background="@drawable/button_black"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="45dp"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="У вас уже есть учетная запись?"
                    android:textColor="@color/blackk"
                    android:textSize="15sp"/>
                <TextView
                    android:id="@+id/textViewLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Войдите в систему прямо сейчас"
                    android:textColor="@color/green"
                    android:textStyle="bold"
                    android:textSize="15sp"/>
            </LinearLayout>
        </RelativeLayout>
    </ScrollView>
</RelativeLayout>