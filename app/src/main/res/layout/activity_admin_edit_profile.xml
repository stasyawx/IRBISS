<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AdminEditProfile"
    android:background="@color/back2">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="35dp"
            android:layout_marginRight="35dp">

            <TextView
                android:id="@+id/profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:textColor="@color/blackk"
                android:textSize="25dp"
                android:textStyle="bold"
                android:layout_marginTop="50dp"
                android:text="Профиль"/>

            <LinearLayout
                android:id="@+id/inputFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/profile"
                android:layout_marginTop="35dp"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:id="@+id/profileCard"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    app:cardCornerRadius="50dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/profile"/>
                </androidx.cardview.widget.CardView>

                <EditText
                    android:enabled="false"
                    android:id="@+id/familiaEditText"
                    android:background="@drawable/rounded_edittext"
                    android:textColorHint="@color/gray"
                    android:textSize="15dp"
                    android:paddingLeft="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:hint="Фамилия"
                    android:inputType="textCapWords|textPersonName"
                    android:textColor="@color/blackk"
                    android:layout_marginTop="15dp"/>
                <EditText
                    android:enabled="false"
                    android:id="@+id/nameEditText"
                    android:background="@drawable/rounded_edittext"
                    android:textColorHint="@color/gray"
                    android:textSize="15dp"
                    android:paddingLeft="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:hint="Имя"
                    android:inputType="textCapWords|textPersonName"
                    android:textColor="@color/blackk"
                    android:layout_marginTop="15dp"/>
                <EditText
                    android:enabled="false"
                    android:id="@+id/otchEditText"
                    android:background="@drawable/rounded_edittext"
                    android:textColorHint="@color/gray"
                    android:textSize="15dp"
                    android:paddingLeft="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:hint="Отчество"
                    android:inputType="textCapWords|textPersonName"
                    android:textColor="@color/blackk"
                    android:layout_marginTop="15dp"/>
                <EditText
                    android:id="@+id/loginEditText"
                    android:background="@drawable/rounded_edittext"
                    android:textColorHint="@color/gray"
                    android:textSize="15dp"
                    android:paddingLeft="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:hint="Адрес электронной почты"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/blackk"
                    android:layout_marginTop="15dp"/>
                <EditText
                    android:enabled="false"
                    android:id="@+id/birthDateEditText"
                    android:background="@drawable/rounded_edittext"
                    android:textColorHint="@color/gray"
                    android:textSize="15dp"
                    android:paddingLeft="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:hint="дд.мм.гггг"
                    android:inputType="date"
                    android:textColor="@color/blackk"
                    android:layout_marginTop="15dp"/>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp">

                    <Button
                        android:id="@+id/saveButton"
                        android:layout_width="150dp"
                        android:layout_height="40dp"
                        android:text="Сохранить"
                        android:textAllCaps="false"
                        android:textSize="15dp"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:background="@drawable/button_green"
                        android:layout_alignParentStart="true"/>

                    <Button
                        android:id="@+id/cancelButton"
                        android:layout_width="150dp"
                        android:layout_height="40dp"
                        android:text="Отмена"
                        android:textAllCaps="false"
                        android:textSize="15dp"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:background="@drawable/button_red"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>

            </LinearLayout>
        </RelativeLayout>
    </ScrollView>
    <LinearLayout
        android:id="@+id/bottomToolbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/tool_bar"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:padding="25dp"
        android:layout_marginBottom="45dp"
        android:elevation="4dp"
        android:translationZ="2dp">

        <ImageView
            android:id="@+id/homeImageView"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/home"
            android:layout_marginLeft="35dp"
            android:layout_gravity="center"/>
        <Space
            android:layout_width="60dp"
            android:layout_height="0dp"/>
        <ImageView
            android:id="@+id/historyImageView"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/history"
            android:layout_gravity="center"/>
        <Space
            android:layout_width="60dp"
            android:layout_height="0dp"/>
        <ImageView
            android:id="@+id/profileImageView"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/profil"
            android:layout_marginRight="35dp"
            android:layout_gravity="center"/>
    </LinearLayout>
</RelativeLayout>